ishikopath = envvar("ISHIKO_CPP_ROOT");
import $(ishikopath)/errors/include/Ishiko/Errors.bkl;
import $(ishikopath)/filesystem/include/Ishiko/FileSystem.bkl;
import $(ishikopath)/io/include/Ishiko/IO.bkl;
import $(ishikopath)/text/include/Ishiko/Text.bkl;
import $(ishikopath)/third-party-glue/include/Ishiko/ThirdParty/Boost.bkl;
import $(ishikopath)/tidy-yaml/include/Ishiko/TidyYAML.bkl;
import $(ishikopath)/uuids/include/Ishiko/UUIDs.bkl;

setting NUIME_BUILDFILES_ROOT
{
    help = "Path to the Nuime/BuildFiles installation";
    default = '$(NUIME_ROOT)/build-files';
}

template NuimeBuildFiles : IshikoUUIDs, IshikoTidyYAML, IshikoFileSystem, IshikoIO, IshikoText, IshikoErrors, Boost
{
    includedirs += $(NUIME_BUILDFILES_ROOT)/include;

    if ($(toolset) == gnu)
    {
        libdirs += $(NUIME_BUILDFILES_ROOT)/lib;
    }

    if ($(toolset) != gnu)
    {
        libdirs += $(NUIME_BUILDFILES_ROOT)/lib/$(arch);
    }
}
